{
	"name": "cdk-lambda-urls1",
	"version": "0.1.0",
	"bin": {
		"cdk-lambda-urls1": "bin/cdk-lambda-urls1.js"
	},
	"scripts": {
		"build": "tsc",
		"watch": "tsc -w",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"synth": "cdk synth",
		"synth34892": "cdk synth --unstable=telemetry --telemetry-file=tmp.log",
		"deploy": ". .env && cdk deploy -O var/outputs.json && cdkoutputs2sh -v",
		"diff": ". .env && cdk diff",
		"destroy": ". .env && cdk destroy",
		"format": "oxfmt",
		"lint": "oxlint",
		"check": "oxfmt && oxlint --fix",
		"hello": ". var/outputs.sh && curl \"${CDK_CDKLAMBDAURLS1STACK_LAMBDA1FUNCTIONURL}hello\"",
		"security": "trivy fs --skip-dirs node_modules,cdk.out . && trivy config --skip-dirs node_modules,cdk.out .",
		"audit": "pnpm audit && trivy fs --scanners vuln package.json"
	},
	"dependencies": {
		"aws-cdk-lib": "2.262.1",
		"constructs": "^10.7.1",
		"hono": "^4.12.34"
	},
	"devDependencies": {
		"@types/node": "26.1.1",
		"aws-cdk": "2.1128.1",
		"cdk-nag": "^3.0.1",
		"cdkoutputs2sh": "^0.0.2",
		"ts-node": "^10.9.2",
		"tsx": "^4.23.0",
		"typescript": "~7.0.2",
		"vitest": "^4.1.10"
	}
}
